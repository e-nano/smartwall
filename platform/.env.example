PORT=8080
HTTP_HOST=127.0.0.1
FRONTEND_DIR=./frontend/dist
FIRMWARE_PORT=8081
FIRMWARE_HOST=0.0.0.0
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=smartwall
MQTT_PASSWORD=replace-with-a-long-random-password
# ESP32 bins broadcast on this LAN UDP port to discover the MQTT broker address.
SMARTWALL_DISCOVERY_HOST=0.0.0.0
SMARTWALL_DISCOVERY_PORT=4210
# Must be reachable from ESP32 bins; do not use localhost for OTA in practice.
PUBLIC_BASE_URL=http://192.168.1.10:8081
OTA_SIGNING_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
FIRMWARE_DIR=./firmware
FIRMWARE_INBOX_DIR=./firmware/incoming
AUTO_UPDATE_FIRMWARE=false
# Signed metadata (.json) and matching binaries (.bin) are required.
FIRMWARE_PUBLIC_KEY_FILE=
# Local development only; devices still require signatures.
ALLOW_UNSIGNED_FIRMWARE=false
# Required for production or non-loopback HTTP binding. Use at least 20 characters.
SMARTWALL_ADMIN_PASSWORD=
SMARTWALL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional official signed release descriptor. Supervisor install supplies file paths.
SMARTWALL_RELEASE_URL=

# Optional local-first cloud mirror. Local SQLite remains authoritative.
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_API_URL=https://smartwall.e-nano.io
# Use the wall ID and one-time token issued by the online company portal.
# Every physical wall gets a different token; do not use a shared company token.
CLOUD_SYNC_SITE_ID=replace-with-portal-wall-id
CLOUD_SYNC_API_TOKEN=replace-with-at-least-32-random-characters
CLOUD_SYNC_INTERVAL_MS=5000
CLOUD_SYNC_BATCH_SIZE=100
CLOUD_SYNC_REQUEST_TIMEOUT_MS=15000
CLOUD_SYNC_HEARTBEAT_MS=60000
CLOUD_SYNC_OUTBOX_RETENTION_DAYS=7
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
CLOUD_BACKUP_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
CLOUD_BACKUP_INTERVAL_MS=86400000

# Optional HTTPS portal address for the automatic wall approval flow.
# Defaults to the E-Nano hosted service; independent implementations may override it.
CLOUD_PORTAL_URL=https://smartwall.e-nano.io

# Local permission defaults for remote commands. The Cloud sync panel saves overrides in SQLite.
# Both also require cloud synchronization to be enabled and a valid user grant in the cloud.
CLOUD_REMOTE_CONTROL_ENABLED=false
CLOUD_REMOTE_CATALOGUE_ENABLED=false
